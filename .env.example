# --- Face detection/matching ---
FACE_DETECTION_MODEL=hog
# Metode sama seperti versi kamera: face_distance (Euclidean), bukan cosine.
# Makin KECIL makin ketat. 0.5 = default (sama seperti versi kamera).
FACE_MATCH_TOLERANCE=0.5

# --- Attendance ---
MIN_SECONDS_BETWEEN_ATTENDANCE=60
TIMEZONE=Asia/Jakarta

# --- Security ---
# WAJIB diganti sebelum deploy - jangan pakai nilai default di production.
ADMIN_API_KEY=change-me-in-env

LOG_LEVEL=INFO
