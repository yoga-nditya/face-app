# --- Face detection/matching ---
FACE_DETECTION_MODEL=hog
# Metode sama seperti versi kamera: face_distance (Euclidean), bukan cosine.
# Makin KECIL makin ketat. 0.5 = default (sama seperti versi kamera).
FACE_MATCH_TOLERANCE=0.5

# Laplacian variance minimum untuk lolos quality check. Default 25 (diturunkan
# dari 60) karena foto normal dari kamera HP dengan background polos/kulit
# halus sering punya variance rendah meski tidak blur secara visual. Sesuaikan
# lagi berdasarkan hasil scripts/check_blur.py terhadap foto asli kamu.
BLUR_LAPLACIAN_THRESHOLD=25

# --- Attendance ---
MIN_SECONDS_BETWEEN_ATTENDANCE=60
TIMEZONE=Asia/Jakarta

# --- Security ---
# WAJIB diganti sebelum deploy - jangan pakai nilai default di production.
ADMIN_API_KEY=change-me-in-env

LOG_LEVEL=INFO